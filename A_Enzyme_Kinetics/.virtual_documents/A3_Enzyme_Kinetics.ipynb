def michaelis_menten_model(variables, time, parameters):
    
    S, P = variables[0], variables[1]
    
    k_max, K_m = parameters[0], parameters[1]
    
    dS_dt  = - k_max*S/(K_m + S)
    dP_dt  =   k_max*S/(K_m + S) 
    
    return [dS_dt, dP_dt]



